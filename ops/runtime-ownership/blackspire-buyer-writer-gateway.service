# Blackspire Buyer Writer local gateway (REVIEW TEMPLATE, MUST BE RENDERED)
#
# The gateway-only installer replaces every @BLACKSPIRE_GATEWAY_RELEASE_SHA@
# and @BLACKSPIRE_GATEWAY_CONFIG_PATH@ token before installation.  An
# installed unit containing a template token is invalid.  In particular, this
# unit must never resolve executable authority through `current`.
[Unit]
Description=Blackspire Buyer Writer local Unix-socket gateway
After=network-online.target
Wants=network-online.target
Before=blackspire-command.service blackspire-command-worker.service
PartOf=blackspire-command.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=blackspire-writer
# The API-specific group is required only for the 0660 Unix socket.  The
# writer's private group is its only supplementary group and permits read-only
# traversal of the dedicated root-owned secret hierarchy.  The writer is
# never a member of the broad `blackspire` application group.
Group=blackspire-api
SupplementaryGroups=blackspire-writer
WorkingDirectory=/opt/blackspire-command/releases/@BLACKSPIRE_GATEWAY_RELEASE_SHA@
RuntimeDirectory=blackspire
RuntimeDirectoryMode=0750
UMask=0007
Environment=PATH=/opt/nodejs/node-v22.23.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=BLACKSPIRE_BUYER_WRITER_GATEWAY_CONFIG=@BLACKSPIRE_GATEWAY_CONFIG_PATH@
ExecStart=/opt/nodejs/node-v22.23.1-linux-x64/bin/node /opt/blackspire-command/releases/@BLACKSPIRE_GATEWAY_RELEASE_SHA@/packages/buyer-writer/gateway-entry.js --configuration @BLACKSPIRE_GATEWAY_CONFIG_PATH@
ExecStartPost=/opt/nodejs/node-v22.23.1-linux-x64/bin/node /opt/blackspire-command/releases/@BLACKSPIRE_GATEWAY_RELEASE_SHA@/packages/buyer-writer/gateway-readiness.js --configuration @BLACKSPIRE_GATEWAY_CONFIG_PATH@
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=20
KillMode=mixed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ReadWritePaths=/run/blackspire
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=blackspire-command.target
