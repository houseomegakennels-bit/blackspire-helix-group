# REVIEW TEMPLATE ONLY — installation and alert routing require separate operator authorization.
[Unit]
Description=Blackspire Command local production health monitor
OnFailure=blackspire-command-monitor-alert@%n.service

[Service]
Type=oneshot
User=blackspire
Group=blackspire
WorkingDirectory=/opt/blackspire-command/current
EnvironmentFile=/etc/blackspire/command.env
Environment=PATH=/opt/nodejs/node-v22.23.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=BLACKSPIRE_NODE_BIN=/opt/nodejs/node-v22.23.1-linux-x64/bin/node
Environment=BLACKSPIRE_MONITOR_STATE_DIR=/var/lib/blackspire-command-monitor
StateDirectory=blackspire-command-monitor
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/bash ops/blackspire-command-monitor.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
