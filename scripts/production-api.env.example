# Blackspire Command API-only authentication profile.
#
# Install as /etc/blackspire/command-api.env with root:blackspire-api ownership and mode 0640. The API
# service loads this after command.env. The worker service must never load or otherwise receive it.
# Values are supplied by the operator and never committed.
COMMAND_ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional machine bearer authentication remains separate from browser password/session auth.
ALLOW_BEARER_AUTH=false
COMMAND_ADMIN_TOKEN=
# Separate receiver-to-API credential. The receiver must also present a valid
# single-use task authority permit; this token alone authorizes no capability.
BLACKSPIRE_AUTHORITY_CONSUMER_TOKEN=
