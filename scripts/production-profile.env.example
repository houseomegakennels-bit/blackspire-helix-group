# Approved durable-VPS no-external-provider profile. Inject through an operator
# configuration manager; never commit the real values.
NODE_ENV=production
BLACKSPIRE_RUNTIME_MODE=production
BLACKSPIRE_STATE_OWNER=vps-production
# Runtime identity is derived from the role-specific systemd supervisor. Do not place a generic
# BLACKSPIRE_RUNTIME_USER here: EnvironmentFile values can override unit role settings.
# Canonical persisted admin principal whose active workspace grants authorize Jarvis HTTP routes.
# Provision and verify the principal/grants as an explicit database operation before activation.
BLACKSPIRE_OPERATOR_PRINCIPAL_ID=blackspire-operator
BLACKSPIRE_PROVIDER_MODE=manual
BLACKSPIRE_HERMES_MODE=restricted
# Real provider execution is off by default and is an explicit operator decision. While this is
# 'disabled' the profile above is the approved no-external-provider profile: manual provider mode,
# and ExecStartPre refuses to start if any provider credential is present at all.
#
# To authorize real execution, set this to exactly 'enabled' and supply, together:
#   BLACKSPIRE_PRODUCTION_EXECUTION=enabled
#   BLACKSPIRE_PROVIDER_MODE=<one provider from the allowlist below, e.g. codex>
#   BLACKSPIRE_HERMES_MODE=production
#   BLACKSPIRE_PRODUCTION_PROVIDERS=codex
#   BLACKSPIRE_PRODUCTION_MODEL=<optional; the server-chosen Codex model/configuration>
#   CODEX_HOME=/opt/blackspire-command/shared/codex
#
# Codex production execution uses the authenticated Codex CLI. CODEX_API_KEY/CODEX_API_ENDPOINT
# direct-api mode is not implemented and is refused by ExecStartPre. OpenAI and Anthropic API
# providers, including Claude Code, are disabled in production execution until conservative
# monetary cost accounting can enforce the task ceiling before dispatch and reconcile actual
# usage afterward.
#
# ExecStartPre validates the whole set as one unit and refuses a partial opt-in, an allowlist
# containing mock or an unknown provider, an unimplemented provider mode, and provider credentials
# that would widen the runtime process without an executable accounting contract.
BLACKSPIRE_PRODUCTION_EXECUTION=disabled
# BLACKSPIRE_PRODUCTION_PROVIDERS=
# BLACKSPIRE_PRODUCTION_MODEL=
# Codex CLI subscription authentication/state for production execution. Required when Codex is
# allowlisted. It must be outside protected home directories and under the persistent shared tree,
# because the reviewed systemd unit uses ProtectHome=yes and ReadWritePaths=/opt/blackspire-command/shared.
CODEX_HOME=/opt/blackspire-command/shared/codex
TELEGRAM_MODE=dry-run
UNIFIED_IPHONE_TEST_MODE=false
BLACKSPIRE_DB_PATH=/opt/blackspire-command/shared/database/command.sqlite
BLACKSPIRE_DATA_DIR=/opt/blackspire-command/shared/database
# Backup destination for the WAL-safe pre-activation backup and every later rehearsal. It must sit
# under the persistent shared tree, which is the only path the unit's ReadWritePaths allows.
BLACKSPIRE_BACKUP_DIR=/opt/blackspire-command/shared/backups
# The git checkout Hermes uses as the cwd for its git and build work. Required in production and
# validated by scripts/verify-environment.sh before the supervisor starts; there is no default,
# because the development default "." is the immutable release, which is read-only to this account.
# It must sit under the persistent shared tree for the same reason BLACKSPIRE_BACKUP_DIR does: the
# unit's ReadWritePaths allows no other writable path. Seed it as a real checkout (package.json,
# apps/, packages/, and a non-symlinked .git) before activation, or ExecStartPre refuses to start.
BLACKSPIRE_WORKSPACE_ROOT=/opt/blackspire-command/shared/workspace
PUBLIC_BASE_URL=https://command.example.invalid
# Loopback-only application bind. The reverse proxy is the sole public surface; this port is
# never opened publicly and must never be a wildcard address.
BIND_HOST=127.0.0.1
# Explicit, non-conflicting port. 8787 (existing API/worker) and 8788 (restricted staging) are
# rejected. 8789 is the reviewed preference; confirm it is free with
# `node scripts/select-production-port.js` before activation.
PORT=8789
# Bounded startup and health budgets required by both ExecStartPre and verifyVpsRuntime.
BLACKSPIRE_STARTUP_TIMEOUT_SECONDS=30
BLACKSPIRE_HEALTH_TIMEOUT_SECONDS=5
# Production has a separate durable worker service; API health/readiness must fail closed when its
# heartbeat is missing, stale, stopped, or draining.
BLACKSPIRE_REQUIRE_WORKER_HEARTBEAT=true
SECURE_COOKIES=true
RATE_LIMIT_DISABLED=false
DEBUG=false
TRUST_PROXY=true
GIT_WORKFLOW_ENABLED=false
# Authentication credentials do not belong in this shared API/worker profile. Supply them only in
# /etc/blackspire/command-api.env, created from production-api.env.example and loaded only by the
# API unit. The worker preflight fails closed if any of them appear here.
