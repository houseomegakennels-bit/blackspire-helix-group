# Approved durable-VPS no-external-provider profile. Inject through an operator
# configuration manager; never commit the real values.
NODE_ENV=production
BLACKSPIRE_RUNTIME_MODE=production
BLACKSPIRE_STATE_OWNER=vps-production
# Must match the User= identity in the reviewed systemd unit.
BLACKSPIRE_RUNTIME_USER=blackspire
BLACKSPIRE_PROVIDER_MODE=manual
BLACKSPIRE_HERMES_MODE=restricted
TELEGRAM_MODE=dry-run
UNIFIED_IPHONE_TEST_MODE=false
BLACKSPIRE_DB_PATH=/opt/blackspire-command/shared/database/command.sqlite
BLACKSPIRE_DATA_DIR=/opt/blackspire-command/shared/database
# Backup destination for the WAL-safe pre-activation backup and every later rehearsal. It must sit
# under the persistent shared tree, which is the only path the unit's ReadWritePaths allows.
BLACKSPIRE_BACKUP_DIR=/opt/blackspire-command/shared/backups
# The git checkout Hermes uses as the cwd for its git and build work. Required in production and
# validated by scripts/verify-environment.sh before the supervisor starts; there is no default,
# because the development default "." is the immutable release, which is read-only to this account.
# It must sit under the persistent shared tree for the same reason BLACKSPIRE_BACKUP_DIR does: the
# unit's ReadWritePaths allows no other writable path. Seed it as a real checkout (package.json,
# apps/, packages/, and a non-symlinked .git) before activation, or ExecStartPre refuses to start.
BLACKSPIRE_WORKSPACE_ROOT=/opt/blackspire-command/shared/workspace
PUBLIC_BASE_URL=https://command.example.invalid
# Loopback-only application bind. The reverse proxy is the sole public surface; this port is
# never opened publicly and must never be a wildcard address.
BIND_HOST=127.0.0.1
# Explicit, non-conflicting port. 8787 (existing API/worker) and 8788 (restricted staging) are
# rejected. 8789 is the reviewed preference; confirm it is free with
# `node scripts/select-production-port.js` before activation.
PORT=8789
# Bounded startup and health budgets required by both ExecStartPre and verifyVpsRuntime.
BLACKSPIRE_STARTUP_TIMEOUT_SECONDS=30
BLACKSPIRE_HEALTH_TIMEOUT_SECONDS=5
SECURE_COOKIES=true
RATE_LIMIT_DISABLED=false
DEBUG=false
TRUST_PROXY=true
GIT_WORKFLOW_ENABLED=false
# COMMAND_ADMIN_TOKEN and SESSION_SECRET are required and supplied externally.
