BLACKSPIRE_RUNTIME_MODE=mock
BLACKSPIRE_HERMES_MODE=mock
RESTRICTED_HERMES_URL=
HERMES_TIMEOUT_MS=30000
COMMAND_ADMIN_TOKEN=
ALLOW_BEARER_AUTH=false
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
TRUST_PROXY=false
TELEGRAM_MODE=mock
TELEGRAM_ALLOWED_USERS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
CORS_MODE=same-origin
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CODEX_API_ENDPOINT=
CODEX_API_KEY=
GITHUB_TOKEN=
# Absolute path to the git checkout Hermes uses as the cwd for git and build work. Leave unset to
# keep the historical "." default. Under the immutable-release/systemd deployment the process cwd is
# the read-only release, so a durable host should point this at a real writable checkout. When set it
# must be absolute, existing, a directory, not a symlink, and a git checkout, or startup fails closed.
BLACKSPIRE_WORKSPACE_ROOT=
BLACKSPIRE_DATA_DIR=.blackspire-command
BLACKSPIRE_DB_PATH=.blackspire-command/command.sqlite
BLACKSPIRE_STATE_OWNER=development
PORT=8787
